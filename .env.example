# ==============================================================================
# Sentinel Vision AI — Root Environment Template
# ==============================================================================

NODE_ENV=development
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
MOBILE_BASE_URL=https://sentinel-mobile.example.com

# ─── API Configuration ────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ─── Authentication & Session Tokens ──────────────────────────────────────────
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_REFRESH_TTL=30d
COOKIE_SECRET=your_secure_cookie_signing_secret_min_32_chars
COOKIE_DOMAIN=localhost

# ─── OAuth 2.0 Providers (Google & GitHub) ────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback

# ─── Email Delivery (Brevo & Local Dev Mailpit) ───────────────────────────────
EMAIL_TRANSPORT=smtp-dev
BREVO_API_KEY=
BREVO_SENDER_NAME="Sentinel Vision AI"
BREVO_SENDER_EMAIL=notifications@sentinelvision.ai
BREVO_TIMEOUT_SECONDS=10
BREVO_MAX_RETRIES=2
SMTP_DEV_HOST=localhost
SMTP_DEV_PORT=1025

# ─── Auth Governance Policies ─────────────────────────────────────────────────
AUTH_ALLOWED_EMAIL_DOMAINS=
AUTH_REQUIRE_ADMIN_APPROVAL=true
AUTH_REGISTRATION_ENABLED=true
SEED_DEFAULT_PASSWORD=Sentinel@2026

# ─── WebRTC Media & Mobile Streaming ──────────────────────────────────────────
TURN_SECRET=sentinel_turn_secret_2026
MEDIA_BASE_URL=http://localhost:8889

# ─── Cloudflare Turnstile CAPTCHA ─────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/sentinel_vision

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Kafka (KRaft mode) ───────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sentinel-cluster

# ─── MinIO / S3 Storage ───────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_PHOTOS=reference-photos
MINIO_BUCKET_THUMBNAILS=sighting-thumbnails
MINIO_BUCKET_CROPS=frame-crops

# ─── Pinecone Vector Database ─────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_FACE_INDEX=face-embeddings
PINECONE_REID_INDEX=reid-embeddings

# ─── Inference Service ────────────────────────────────────────────────────────
INFERENCE_HOST=localhost
INFERENCE_PORT=8000
ARCFACE_MODEL_VERSION=arcface-r100-v1
OSNET_MODEL_VERSION=osnet-ain-x1.0-v1
YOLO_MODEL_VERSION=yolov8n-v1
SCRFD_MODEL_VERSION=scrfd-10g-v1

# ─── Next.js Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_APP_NAME="Sentinel Vision AI"
NEXT_PUBLIC_MAP_STYLE_LIGHT=
NEXT_PUBLIC_MAP_STYLE_DARK=
NEXT_PUBLIC_MAP_DEFAULT_CENTER="-74.006,40.7128"
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=14

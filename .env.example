# ==============================================================================
# Sentinel Vision AI - Root Monorepo Environment Variables Reference
# ==============================================================================

NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
MOBILE_BASE_URL=

JWT_ACCESS_SECRET=replace_with_generated_jwt_access_secret_min_32_chars
REFRESH_TOKEN_PEPPER=replace_with_generated_refresh_pepper_min_32_chars
COOKIE_SECRET=replace_with_generated_cookie_secret_min_32_chars
INTERNAL_SERVICE_TOKEN=replace_with_generated_internal_token_min_32_chars

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sentinel-vision-ai?retryWrites=true&w=majority
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_url_safe_redis_password
KAFKA_BROKERS=localhost:9092

PINECONE_API_KEY=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_INDEX_FACE=sentinel-face
PINECONE_INDEX_REID=sentinel-reid
PINECONE_FACE_DIM=512
PINECONE_REID_DIM=512

STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_ROOT_FOLDER=sentinel/dev
RECORDING_DRIVER=minio

TURN_SECRET=replace_with_generated_turn_secret_min_16_chars

# ------------------------------------------------------------------------------
# 11. Initial Super Admin Bootstrap Configuration
# ------------------------------------------------------------------------------
# Enable or disable automatic Super Admin provisioning on application startup
ADMIN_BOOTSTRAP_ENABLED=false

# Full name and professional title for the bootstrap administrator
ADMIN_NAME=System Administrator

# Official email address for the bootstrap super admin (required if bootstrap enabled)
ADMIN_EMAIL=admin@sentinel.gov

# Temporary bootstrap passphrase (min 12 chars with upper, lower, digit, symbol)
# Note: remove or blank this variable after first boot to prevent credential leakage
ADMIN_PASSWORD=replace_with_complex_temporary_admin_passphrase_min_12_chars

# Official departmental badge identification code
ADMIN_BADGE_NUMBER=SA-0001

# Organizational unit or supervisory department
ADMIN_DEPARTMENT=Platform Administration

# Force the administrator to change this passphrase on first interactive login (must be true in prod)
ADMIN_MUST_CHANGE_PASSWORD=true

# Force the administrator to enroll in TOTP two-factor authentication on first login
ADMIN_REQUIRE_MFA_SETUP=true

# Development only: forcibly overwrite an existing super_admin's password and revoke sessions
ADMIN_FORCE_PASSWORD_RESET=false

# Development only: promote an existing account with ADMIN_EMAIL to super_admin
ADMIN_PROMOTE_EXISTING=false

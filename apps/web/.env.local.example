# Sentinel Vision Web Environment Variables (Client & Server)
# Copy to apps/web/.env.local for local development

# Base URL of the NestJS REST API Gateway
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket / Socket.IO URL for real-time telemetry and alerts
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Public WebRTC / WHEP Media server endpoint for video streaming
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8889

# Public HTTPS URL for mobile camera operator PWA and video ingest
# In dev: leave blank or use HTTPS ngrok / cloudflared tunnel
NEXT_PUBLIC_MOBILE_BASE_URL=

# Cloudflare Turnstile CAPTCHA public site key
# Dev testing dummy key: 1x00000000000000000000AA (always passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Application Branding
NEXT_PUBLIC_APP_NAME="Sentinel Vision AI"

# MapLibre Styles & Default Center
NEXT_PUBLIC_MAP_DEFAULT_CENTER="-74.006,40.7128"
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=14
NEXT_PUBLIC_MAP_STYLE_LIGHT=
NEXT_PUBLIC_MAP_STYLE_DARK=

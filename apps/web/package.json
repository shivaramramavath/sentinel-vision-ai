    "check:no-mocks": "node -e \"const fs = require('fs'), path = require('path'); function walk(d) { for (const f of fs.readdirSync(d)) { const p = path.join(d, f); if (fs.statSync(p).isDirectory()) { if (f !== 'node_modules' && f !== '.next') walk(p); } else if (/\\.(tsx?|jsx?)$/.test(f)) { const content = fs.readFileSync(p, 'utf8'); if (/MOCK_|from ['\\\"][^'\\\"]*mocks\\/|NEXT_PUBLIC_USE_MOCKS/.test(content)) { console.error('Found mock reference in ' + p); process.exit(1); } } } } walk('./src'); console.log('✅ CI guardrail passed: zero mock references in apps/web/src');\"",

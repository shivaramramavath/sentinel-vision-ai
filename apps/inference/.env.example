# Sentinel Vision Inference Service Environment Variables
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
ENVIRONMENT=development

# Kafka
KAFKA_BROKERS=localhost:9092

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_PHOTOS=reference-photos
MINIO_BUCKET_THUMBNAILS=sighting-thumbnails
MINIO_BUCKET_CROPS=frame-crops

# Pinecone
PINECONE_API_KEY=
PINECONE_FACE_INDEX=face-embeddings
PINECONE_REID_INDEX=reid-embeddings

# Model Versions (Strictly Separate Feature Spaces)
ARCFACE_MODEL_VERSION=arcface-r100-v1
OSNET_MODEL_VERSION=osnet-ain-x1.0-v1
YOLO_MODEL_VERSION=yolov8n-v1
SCRFD_MODEL_VERSION=scrfd-10g-v1

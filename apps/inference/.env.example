# Sentinel Vision AI - Python Inference Engine Environment Variables
# Copy to apps/inference/.env for local development

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
ENVIRONMENT=development

# Device selection: cpu, cuda, mps
DEVICE=cpu
MODEL_DIR=./models

# Internal API Communication (for fetching raw media streams and posting candidate sightings)
API_INTERNAL_URL=http://localhost:3001
INTERNAL_SERVICE_TOKEN=replace_with_generated_secret

# Kafka Event Bus
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sentinel-inference
KAFKA_GROUP_ID=sentinel-inference-workers

# Vector DB (Pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_FACE=sentinel-face
PINECONE_INDEX_REID=sentinel-reid
PINECONE_NAMESPACE_PREFIX=dev

# Biometric Model Registry
FACE_MODEL_NAME=adaface-ir50-v2
REID_MODEL_NAME=osnet-ain-x1.0-v1
YOLO_MODEL_NAME=yolov8n-v1
SCRFD_MODEL_NAME=scrfd-10g-v1

# ==============================================================================
# Sentinel Vision AI - NestJS Backend API Gateway Environment Variables
# Copy to apps/api/.env for local development. Never commit live secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Runtime environment: development | production | test
NODE_ENV=development

# Port on which the NestJS HTTP application listens (e.g. 3001)
API_PORT=3001

# Network interface host binding (0.0.0.0 listens on all interfaces)
API_HOST=0.0.0.0

# Global URL route prefix for all REST API endpoints
API_GLOBAL_PREFIX=api/v1

# Public-facing URL of the NestJS API Gateway
API_URL=http://localhost:3001

# Public-facing URL of the Next.js Frontend application
WEB_URL=http://localhost:3000

# Public HTTPS URL of the Mobile Operator streaming PWA
# For local development with mobile devices, start an HTTPS tunnel (e.g. cloudflared or ngrok)
MOBILE_BASE_URL=

# Allowed origins for Cross-Origin Resource Sharing (comma-separated list)
CORS_ORIGIN=http://localhost:3000

# Pino logger minimum level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Express trust proxy setting: boolean or hop count
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 2. Authentication, Session & Cryptographic Secrets
# ------------------------------------------------------------------------------
# 32+ character HMAC secret used to sign short-lived JWT access tokens
# Obtain: generate with `pnpm env:rotate JWT_ACCESS_SECRET`
JWT_ACCESS_SECRET=replace_with_generated_jwt_access_secret_min_32_chars

# Access token time-to-live string (e.g. '15m', '1h')
JWT_ACCESS_TTL=15m

# JWT issuer claim identity
JWT_ISSUER=sentinel-vision-ai

# Expected JWT audience claim for Web application users
JWT_AUDIENCE_WEB=web

# Expected JWT audience claim for Mobile streaming operator users
JWT_AUDIENCE_MOBILE=mobile

# 32+ character secret pepper used to hash refresh token IDs before Redis storage
# Obtain: generate with `pnpm env:rotate REFRESH_TOKEN_PEPPER`
REFRESH_TOKEN_PEPPER=replace_with_generated_refresh_pepper_min_32_chars

# Idle session inactivity timeout duration (e.g. '8h', '2h')
SESSION_IDLE_TTL=8h

# Absolute maximum session lifetime before forced re-login (e.g. '30d')
SESSION_ABSOLUTE_TTL=30d

# Absolute maximum session lifetime for administrative roles (e.g. '7d')
SESSION_ABSOLUTE_TTL_ADMIN=7d

# Maximum active concurrent sessions per user account
SESSION_MAX_CONCURRENT=5

# Grace period in seconds to handle concurrent refresh requests
REFRESH_GRACE_SECONDS=15

# Time-to-live duration for step-up multi-factor re-authentication tokens (e.g. '10m')
STEP_UP_TTL=10m

# 32+ character secret used to sign and verify httpOnly session cookies
# Obtain: generate with `pnpm env:rotate COOKIE_SECRET`
COOKIE_SECRET=replace_with_generated_cookie_secret_min_32_chars

# Cookie domain scope (leave blank for host-only cookies in dev)
COOKIE_DOMAIN=

# Enforce HTTPS-only transmission for authentication cookies (must be true in prod)
COOKIE_SECURE=false

# SameSite cookie attribute: lax | strict | none
COOKIE_SAMESITE=lax

# Name of the httpOnly cookie storing the session refresh token
REFRESH_COOKIE_NAME=sentinel_rt

# 32+ character internal shared bearer token for Python inference worker requests
# Obtain: generate with `pnpm env:rotate INTERNAL_SERVICE_TOKEN`
INTERNAL_SERVICE_TOKEN=replace_with_generated_internal_token_min_32_chars

# ------------------------------------------------------------------------------
# 3. OAuth 2.0 Identity Providers
# ------------------------------------------------------------------------------
# Enable Google Workspace / Gmail OAuth login
OAUTH_GOOGLE_ENABLED=false

# Google OAuth 2.0 Client ID
# Obtain: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=

# Google OAuth 2.0 Client Secret
# Obtain: Google Cloud Console Credentials page
GOOGLE_CLIENT_SECRET=

# Google OAuth redirect callback URL (must match the authorized URI in GCP)
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Enable GitHub OAuth login
OAUTH_GITHUB_ENABLED=false

# GitHub OAuth App Client ID
# Obtain: GitHub -> Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=

# GitHub OAuth App Client Secret
# Obtain: GitHub OAuth App settings
GITHUB_CLIENT_SECRET=

# GitHub OAuth redirect callback URL (must match the authorization callback in GitHub)
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback

# ------------------------------------------------------------------------------
# 4. Email Delivery (Brevo REST API)
# ------------------------------------------------------------------------------
# Brevo (Sendinblue) transactional REST API Key (xkeysib-...)
# Obtain: Brevo Dashboard -> SMTP & API -> API Keys
BREVO_API_KEY=

# Display name for outbound system transactional emails
BREVO_SENDER_NAME="Sentinel Vision AI"

# Verified sender email address in Brevo
# Obtain: Brevo Dashboard -> Senders & IP -> Verified Senders
BREVO_SENDER_EMAIL=noreply@sentinel.gov

# HTTP request timeout in seconds for outbound Brevo API calls
BREVO_TIMEOUT_SECONDS=10

# Maximum retry attempts for failed Brevo delivery calls
BREVO_MAX_RETRIES=5

# BullMQ outbound queue rate limit (emails dispatched per minute)
EMAIL_RATE_PER_MINUTE=20

# Daily soft cap for transactional emails (security-critical emails bypass cap)
EMAIL_DAILY_CAP=250

# Optional webhook signature secret for POST /webhooks/brevo
BREVO_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. Governance, Security & Rate Limiting
# ------------------------------------------------------------------------------
# Whitelisted email domains allowed to self-register (comma-separated; empty allows any)
AUTH_ALLOWED_EMAIL_DOMAINS=sentinel.gov,police.gov,investigation.state.gov

# Require supervisor/administrator approval before newly registered users can log in
AUTH_REQUIRE_ADMIN_APPROVAL=true

# Allow public user registration from the sign-up page
AUTH_REGISTRATION_ENABLED=true

# Number of failed login attempts before locking user account
AUTH_MAX_FAILED_LOGINS=5

# Account lockout duration in minutes after exceeding maximum failed logins
AUTH_LOCKOUT_MINUTES=15

# Sliding rate limit window duration in seconds
THROTTLE_TTL_SECONDS=60

# Maximum requests per client IP inside the sliding rate limit window
THROTTLE_LIMIT=100

# 12+ character default initial password for seeded administrator & investigator users
# Obtain: generate with `pnpm env:rotate SEED_DEFAULT_PASSWORD`
SEED_DEFAULT_PASSWORD=replace_with_strong_seed_password_min_12_chars

# ------------------------------------------------------------------------------
# 6. CAPTCHA Verification (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# Cloudflare Turnstile Server Secret Key
# Obtain: Cloudflare Dashboard -> Turnstile -> Add Site
# Dev testing secret key: 1x0000000000000000000000000000000AA (always passes)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ------------------------------------------------------------------------------
# 7. Database & Caching Infrastructure
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas mongodb+srv:// or standalone replica set)
# Obtain: MongoDB Atlas -> Clusters -> Connect -> Drivers
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sentinel-vision-ai?retryWrites=true&w=majority

# Redis cache and session host (e.g. localhost or container redis)
REDIS_HOST=localhost

# Redis service port (default: 6379)
REDIS_PORT=6379

# Redis authentication password (must be URL-safe without $#@&*^! characters)
# Obtain: generate with `pnpm env:rotate REDIS_PASSWORD`
REDIS_PASSWORD=replace_with_url_safe_redis_password

# Redis logical database index (default: 0)
REDIS_DB=0

# Key namespace prefix for Redis keys (e.g. sentinel:)
REDIS_KEY_PREFIX=sentinel:

# Comma-separated list of Kafka broker endpoints (e.g. localhost:9092)
KAFKA_BROKERS=localhost:9092

# Client identifier for Kafka producer & consumer connections
KAFKA_CLIENT_ID=sentinel-api

# Consumer group identifier for Kafka event consumers
KAFKA_GROUP_ID=sentinel-api

# ------------------------------------------------------------------------------
# 8. Vector Database (Pinecone)
# ------------------------------------------------------------------------------
# Pinecone API Key
# Obtain: Pinecone Console -> API Keys
PINECONE_API_KEY=

# Cloud provider for serverless Pinecone indexes: aws | gcp | azure
PINECONE_CLOUD=aws

# Cloud region for serverless Pinecone indexes (e.g. us-east-1)
PINECONE_REGION=us-east-1

# Index name for facial recognition embedding gallery
PINECONE_INDEX_FACE=sentinel-face

# Index name for person re-identification (Re-ID) embedding gallery
PINECONE_INDEX_REID=sentinel-reid

# Facial embedding dimensionality (must match model output: 512 for AdaFace/ArcFace)
PINECONE_FACE_DIM=512

# Re-ID embedding dimensionality (must match model output: 512 for OSNet-AIN)
PINECONE_REID_DIM=512

# Vector distance metric: cosine | dotproduct | euclidean
PINECONE_METRIC=cosine

# Environment namespace prefix for isolating case vector data (e.g. dev)
PINECONE_NAMESPACE_PREFIX=dev

# ------------------------------------------------------------------------------
# 9. Media & Evidentiary Storage (Cloudinary & Continuous Recordings)
# ------------------------------------------------------------------------------
# Active media driver for evidentiary assets: cloudinary | minio
STORAGE_DRIVER=cloudinary

# Cloudinary cloud account name
# Obtain: Cloudinary Dashboard -> Product Environment Settings
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary REST API Key
# Obtain: Cloudinary Dashboard -> Access Keys
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary REST API Secret
# Obtain: Cloudinary Dashboard -> Access Keys
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Composite Cloudinary configuration URL (alternative to separate cloud/key/secret)
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloudinary_cloud_name

# Root namespace folder in Cloudinary for isolating environment assets
CLOUDINARY_ROOT_FOLDER=sentinel/dev

# Default time-to-live in seconds for HMAC-SHA signed delivery URLs
CLOUDINARY_SIGNED_URL_TTL_SECONDS=300

# Publicly accessible webhook URL for async Cloudinary notifications (optional)
CLOUDINARY_NOTIFICATION_URL=http://localhost:3001/api/v1/webhooks/cloudinary

# Maximum allowed file upload size in MB for images
CLOUDINARY_MAX_IMAGE_MB=25

# Maximum allowed file upload size in MB for video clips
CLOUDINARY_MAX_VIDEO_MB=100

# Continuous 24/7 video recording storage driver: minio | local | off
RECORDING_DRIVER=minio

# ------------------------------------------------------------------------------
# 10. Live Video Streaming & WebRTC / TURN Infrastructure
# ------------------------------------------------------------------------------
# MediaMTX WebRTC / WHEP public playback base URL
MEDIA_BASE_URL=http://localhost:8889

# MediaMTX HLS playback base URL
MEDIA_HLS_URL=http://localhost:8888

# MediaMTX RTSP stream ingestion base URL
MEDIA_RTSP_URL=rtsp://localhost:8554

# MediaMTX internal REST management API URL
MEDIA_API_URL=http://localhost:9997

# Comma-separated list of public STUN servers for WebRTC ICE negotiation
STUN_URLS=stun:stun.l.google.com:19302

# Comma-separated list of TURN relay servers for symmetric NAT traversal
TURN_URLS=turn:localhost:3478

# 16+ character static authentication secret shared with Coturn turnserver
# Obtain: generate with `pnpm env:rotate TURN_SECRET`
TURN_SECRET=replace_with_generated_turn_secret_min_16_chars

# Lifetime in seconds for ephemeral coturn username/password credentials
TURN_CREDENTIAL_TTL_SECONDS=600

# ------------------------------------------------------------------------------
# 11. Initial Super Admin Bootstrap Configuration
# ------------------------------------------------------------------------------
# Enable or disable automatic Super Admin provisioning on application startup
ADMIN_BOOTSTRAP_ENABLED=false

# Full name and professional title for the bootstrap administrator
ADMIN_NAME=System Administrator

# Official email address for the bootstrap super admin (required if bootstrap enabled)
ADMIN_EMAIL=admin@sentinel.gov

# Temporary bootstrap passphrase (min 12 chars with upper, lower, digit, symbol)
# Note: remove or blank this variable after first boot to prevent credential leakage
ADMIN_PASSWORD=replace_with_complex_temporary_admin_passphrase_min_12_chars

# Official departmental badge identification code
ADMIN_BADGE_NUMBER=SA-0001

# Organizational unit or supervisory department
ADMIN_DEPARTMENT=Platform Administration

# Force the administrator to change this passphrase on first interactive login (must be true in prod)
ADMIN_MUST_CHANGE_PASSWORD=true

# Force the administrator to enroll in TOTP two-factor authentication on first login
ADMIN_REQUIRE_MFA_SETUP=true

# Development only: forcibly overwrite an existing super_admin's password and revoke sessions
ADMIN_FORCE_PASSWORD_RESET=false

# Development only: promote an existing account with ADMIN_EMAIL to super_admin
ADMIN_PROMOTE_EXISTING=false

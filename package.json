{
  "name": "sentinel-vision-ai",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "seed": "pnpm --filter @sentinel/api seed",
    "seed:accounts": "pnpm --filter @sentinel/api seed:accounts",
    "seed:reset": "pnpm --filter @sentinel/api seed:reset",
    "seed:check": "pnpm --filter @sentinel/api seed:check",
    "seed:refresh-times": "pnpm --filter @sentinel/api seed:refresh-times",
    "env:rotate": "node scripts/gen-secrets.mjs",
    "env:check": "pnpm --filter @sentinel/api env:check",
    "pinecone:init": "pnpm --filter @sentinel/api pinecone:init",
    "kafka:init": "pnpm --filter @sentinel/api kafka:init",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "prepare": "husky",
    "migrate:roles": "pnpm --filter @sentinel/api migrate:roles",
    "admin:create": "pnpm --filter @sentinel/api admin:create",
    "admin:reset-password": "pnpm --filter @sentinel/api admin:reset-password"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "husky": "^9.1.7",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "lint-staged": "^15.3.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}

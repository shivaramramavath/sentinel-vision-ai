{
  "$ref": "#/definitions/Camera",
  "definitions": {
    "Camera": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rtspUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^rtsp\\:\\/\\/"
        },
        "location": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 200
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "building": {
              "type": "string",
              "maxLength": 200
            },
            "floor": {
              "type": "string",
              "maxLength": 50
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "frameRateFps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 5
        },
        "resolutionWidth": {
          "type": "integer",
          "minimum": 1
        },
        "resolutionHeight": {
          "type": "integer",
          "minimum": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50
          },
          "maxItems": 20
        },
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "error"
          ],
          "default": "inactive"
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "rtspUrl",
        "location",
        "id",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
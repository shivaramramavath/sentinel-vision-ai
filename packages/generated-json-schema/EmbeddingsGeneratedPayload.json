          "type": "integer"
        }
      },
      "required": [
        "embeddingId",
        "kind",
        "cameraId",
        "frameId",
        "capturedAt",
        "cropS3Key",
        "model_version",
        "pineconeId",
        "pineconeIndex",
        "vectorDimension",
        "detectionScore",
        "bbox"
      ],
      "additionalProperties": false

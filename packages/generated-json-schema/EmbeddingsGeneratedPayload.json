          "enum": [
            "face",
            "reid"
          ]
        },
        "caseId": {
          "type": "string"
        },
        "cameraId": {
          "type": "string",
          "minLength": 1
        },
        "frameId": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "cropS3Key": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "pineconeId": {
          "type": "string",
          "minLength": 1
        },
        "pineconeIndex": {
          "type": "string",
          "minLength": 1
